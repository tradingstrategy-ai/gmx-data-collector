# GMX Historical Data Collection - Environment Variables

# Required: Arbitrum RPC URL (Alchemy, Infura, QuickNode, etc.)
JSON_RPC_ARBITRUM=https://arb-mainnet.g.alchemy.com/v2/YOUR_ALCHEMY_KEY

# Required: HyperSync API Token(s)
# Space-separated for key rotation (recommended)
HYPERSYNC_API_TOKEN=YOUR_HYPERSYNC_TOKEN_1 YOUR_HYPERSYNC_TOKEN_2 YOUR_HYPERSYNC_TOKEN_3

# Optional: Custom symbols for user-configurable collection
# Comma-separated list (used with "custom" profile)
SYMBOLS=ETH,BTC,SUI,ARB

# Optional: Concurrency level (default: 4)
# Higher values = faster but more resource intensive
CONCURRENCY=4
