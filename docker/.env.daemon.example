# GMX Periodic Data Collection Daemon Configuration

# === REQUIRED ===

# Arbitrum RPC URL (required for GMX API)
JSON_RPC_ARBITRUM=https://arb-mainnet.g.alchemy.com/v2/YOUR_API_KEY_HERE

# === COLLECTION SETTINGS ===

# Collection interval in minutes (default: 60)
# How often to collect fresh data from GMX API
COLLECTION_INTERVAL_MINUTES=60

# Optional: Specific symbols to collect (comma-separated)
# If not set or empty, collects ALL GMX tokens (~118 tokens)
# Example: COLLECTION_SYMBOLS=ETH,BTC,ARB,LINK
COLLECTION_SYMBOLS=

# Optional: Symbols to exclude from collection (comma-separated)
# Default: APE_DEPRECATED
EXCLUDED_SYMBOLS=APE_DEPRECATED

# === STORAGE ===

# Output directory for collected data (default: ./data)
OUTPUT_DIR=/app/data

# === PERFORMANCE ===

# Number of timeframes to fetch concurrently per symbol (1-6, default: 6)
# Higher = faster but more API load
# All 6 timeframes: 1min, 5min, 15min, 1h, 4h, 1D
TIMEFRAME_CONCURRENCY=6

# === MONITORING ===

# Health check HTTP endpoint port (default: 8080)
# Only used if health endpoint is implemented
# HEALTH_CHECK_PORT=8080

# Logging level: DEBUG, INFO, WARNING, ERROR, CRITICAL (default: INFO)
LOG_LEVEL=INFO

# === TESTING ===

# Dry run mode - fetch data but don't save (default: false)
# Useful for testing without modifying data
DRY_RUN=false
